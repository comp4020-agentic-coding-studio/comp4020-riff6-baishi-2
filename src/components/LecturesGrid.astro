---
import { getPublishedCollection } from "astro-course-university/content";
import Card from "astro-theme-university/components/Card.astro";
import CardGrid from "astro-theme-university/components/CardGrid.astro";
import { formatCourseDate } from "../lib/dates";

const lectures = await getPublishedCollection("lectures");
const visible = lectures.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---

<CardGrid columns={2}>
  {
    visible.map((lecture) => (
      <Card
        headingLevel="h2"
        title={lecture.data.title}
        href={`/lectures/${lecture.id}/`}
        image={lecture.data.image}
        imageAlt={lecture.data.imageAlt}
      >
        {lecture.data.description && <p>{lecture.data.description}</p>}
        <p><small>Week {lecture.data.week} · {formatCourseDate(lecture.data.date)}</small></p>
        {lecture.data.imageCredit && (
          <p class="lecture-image-credit">
            <small>Image: {lecture.data.imageCredit}</small>
          </p>
        )}
      </Card>
    ))
  }
</CardGrid>

<style>
  .lecture-image-credit {
    margin-block-start: -0.5rem;
    color: var(--at-text-secondary);
  }
</style>
